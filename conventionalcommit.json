{
    "$schema": "https://github.com/lppedd/idea-conventional-commit/raw/master/src/main/resources/defaults/conventionalcommit.schema.json",
    "types": {
        "feat": {
            "description": "A new feature",
            "scopes": {
                "facade": { "description": "App Layer: Engine API and public interfaces" },
                "domain": { "description": "Domain Layer: Core business logic changes" },
                "registry": { "description": "Domain: SoundRegistry and configuration" },
                "mixer": { "description": "Domain: Mixer logic, layers and snapshots" },
                "router": { "description": "Domain: Logical signal path calculation" },
                "orchestration": { "description": "Domain: SmartLoop music sequencing and grid" },
                "culling": { "description": "Domain: Voice culling business rules" },
                "infra": { "description": "Infra Layer: Technical adapters and Web Audio" },
                "dsp": { "description": "Infra: Filters, Duckers and AudioWorklets" },
                "voices": { "description": "Infra: SoundInstance and Pool management" },
                "rtpc": { "description": "Kernel: Modulation engine and RTPC math" },
                "automation": { "description": "Infra: Sample-accurate parameter curves" },
                "loader": { "description": "Infra: Buffer loading and decoding" }
            }
        },
        "fix": {
            "description": "A bug fix",
            "scopes": {
                "domain": { "description": "Fixes in pure business logic" },
                "facade": { "description": "AudioEngine/Router fixes" },
                "infra": { "description": "Fixes in Web Audio nodes or adapters" },
                "kernel": { "description": "Fixes in modulation math or RTPC Manager" },
                "mixer": { "description": "Fixes in state resolution/layering" },
                "rtpc": { "description": "Fixes in curve calculations or bindings" },
                "dsp": { "description": "Fixes in AudioWorklet processors" },
                "scheduling": { "description": "Fixes in timing and playback scheduler" },
                "debug": { "description": "Visualizer and profiler fixes" }
            }
        },
        "docs": {
            "description": "Documentation only changes",
            "scopes": {
                "architecture": { "description": "Hexagonal design and C4 diagrams" },
                "api": { "description": "Public interface documentation" },
                "readme": { "description": "General project info" }
            }
        },
        "refactor": {
            "description": "A code change that neither fixes a bug nor adds a feature",
            "scopes": {
                "interfaces": { "description": "Refactoring Domain Ports and Types" },
                "shared": { "description": "Refactoring constants and universal helpers" },
                "bus-adapter": { "description": "Refactoring WebAudio Bus implementation" },
                "nodes": { "description": "Refactoring AudioNode chains" },
                "utils": { "description": "Refactoring core/internal utilities" }
            }
        },
        "test": {
            "description": "Adding missing tests or correcting existing tests",
            "scopes": {
                "unit": { "description": "Unit tests for pure classes/helpers" },
                "integration": { "description": "Integration tests for Managers/Buses" },
                "worklets": { "description": "Testing audio thread processors" },
                "mocks": { "description": "Web Audio API mocks updates" }
            }
        },
        "build": {
            "description": "Changes that affect the build system or external dependencies",
            "scopes": {
                "deps": { "description": "Dependencies updates" },
                "bundler": { "description": "Vite/Webpack config" },
                "typescript": { "description": "TSConfig changes" },
                "worklets": { "description": "Worklet compilation pipeline" }
            }
        },
        "ci": {
            "description": "Changes to our CI configuration files and scripts",
            "scopes": {
                "github": { "description": "GitHub Actions workflows" },
                "publish": { "description": "NPM/Registry publishing scripts" }
            }
        },
        "chore": {
            "description": "Other changes that don't modify src or test files",
            "scopes": {
                "config": { "description": "Editor/Workspace configurations" },
                "tools": { "description": "Development scripts and tools" }
            }
        },
        "revert": {
            "description": "Reverts a previous commit"
        }
    },
    "commonScopes": {
        "app": { "description": "Application layer (Entry points/Bootstrapping)" },
        "domain": { "description": "Domain layer (Pure logic/Ports)" },
        "infra": { "description": "Infrastructure layer (Adapters/WebAudio)" },
        "kernel": { "description": "Kernel layer (High-perf math/RTPC)" },
        "shared": { "description": "Shared layer (Math/Guards/Constants)" },
        "facade": { "description": "AudioEngine/Router facades" },
        "bus-system": { "description": "General bus and signal routing" },
        "mixer": { "description": "Mixer states and layering" },
        "rtpc": { "description": "RTPC and modulation" },
        "dsp": { "description": "DSP Plugins and Worklets" },
        "interfaces": { "description": "TS Interfaces and Ports" },
        "test": { "description": "Test suites and mocks" },
        "build": { "description": "Build tools and dependencies" }
    }
}
