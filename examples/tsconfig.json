{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./dist",
        "skipLibCheck": true,
        "noEmit": true,
        "composite": false,
        "rootDir": "../",
        "paths": {
            "@scene-grid/engine": ["../packages/engine/src/index.ts"],
            "@scene-grid/inspector": ["../packages/inspector/src/index.ts"],
            "@scene-grid/shared": ["../packages/shared/src/index.ts"]
        },
        "types": ["vite/client", "node"]
    },
    "include": ["./src/**/*", "./**/*.config.ts", "./main.ts"],
    "exclude": ["node_modules", "**/dist", "**/build", "../packages/*/dist", "../packages/**/dist"],
    "references": [
        { "path": "../packages/shared" },
        { "path": "../packages/engine" },
        { "path": "../packages/inspector" }
    ]
}
