        {
            "id": "claim_e23530e063f340f680cbd5f55528260b",
            "statement": "The sprite sound manifest associates each `SoundId` with one URL or an ordered URL list and optional loading priority, whereas `ISoundMap` associates a `SoundId` with behavior configuration; the sound-config union supports basic, smart-loop, container, layered, switch, and scatterer entries that can reference other sound IDs.",
            "evidence": [
                {
                    "resource": "repo://packages/engine/src/Domain/Configuration/Ports/ISoundConfig.ts#L17-L24",
                    "version": "repo-lines-v1:sha256:6d6fac7f107a863d6d4ef43a8e8ab2428f87aac211195b6c06b150be4ce30f08:"
                },
                {
