{
    "name": "scenegrid-console",
    "version": "1.0.0",
    "description": "Snapshot-Driven Virtual Mixing Console",
    "repository": {
        "type": "git",
        "url": "https://github.com/rapt0p7/scenegrid-console"
    },
    "license": "SEE LICENSE IN LICENSE.md",
    "author": {
        "name": "Igor Zabrodin",
        "url": "https://github.com/rapt0p7"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/scenegrid-audio.es.js",
            "require": "./dist/scenegrid-audio.umd.js"
        }
    },
    "main": "./dist/scenegrid-audio.umd.js",
    "module": "./dist/scenegrid-audio.es.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "scripts": {
        "build": "npm run build:lib && npm run build:demo",
        "build:demo": "vite build",
        "build:lib": "vite build --config vite.library.config.ts",
        "changelog": "git cliff -o CHANGELOG.md",
        "changelog:latest": "git cliff --latest -o CHANGELOG.md",
        "changelog:preview": "git cliff --latest",
        "createDependencyGraph": "npx depcruise src --include-only \"^src\" --exclude \"(__tests__|\\\\.test\\\\.ts$|\\\\.spec\\\\.ts$)\" --output-type mermaid > docs/dependency-graph.mmd",
        "dev": "vite",
        "docs": "typedoc",
        "license-checker": "license-checker --production --failOn \"GPL;GPL-1.0;GPL-2.0;GPL-3.0;LGPL;LGPL-2.0;LGPL-2.1;LGPL-3.0;AGPL;AGPL-1.0;AGPL-3.0;SSPL;CDDL;EUPL;MPL-1.0;NPL;QPL;CPAL;RPL\"\n",
        "lint:architecture": "depcruise src --config .dependency-cruiser.cjs",
        "prepare": "husky || true",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "eslint --cache --fix",
            "prettier --write --cache"
        ],
        "*.json": "prettier --write --cache"
    },
    "browserslist": {
        "production": [
            "> 0.5%",
            "last 2 versions",
            "not IE <= 11",
            "not dead"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "overrides": {
        "typedoc": {
            "typescript": "6.0.2"
        },
        "typescript-eslint": {
            "typescript": "6.0.2"
        }
    },
    "dependencies": {
        "@tweakpane/plugin-essentials": "0.2.1",
        "globalthis": "1.0.4"
    },
    "devDependencies": {
        "@commitlint/cli": "20.5.0",
        "@commitlint/config-conventional": "20.5.0",
        "@eslint/js": "9.39.4",
        "@eslint/json": "1.1.0",
        "@vitest/coverage-v8": "4.1.0",
        "@vitest/eslint-plugin": "1.6.12",
        "browserslist": "4.28.1",
        "cross-env": "10.1.0",
        "dependency-cruiser": "17.3.10",
        "dotenv": "17.3.1",
        "eslint": "9.39.4",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-typescript": "4.4.4",
        "eslint-plugin-boundaries": "6.0.2",
        "eslint-plugin-de-morgan": "2.1.1",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jsonc": "3.1.2",
        "eslint-plugin-markdownlint": "^0.8.1",
        "eslint-plugin-no-secrets": "2.3.3",
        "eslint-plugin-prettier": "5.5.5",
        "eslint-plugin-security": "4.0.0",
        "eslint-plugin-sonarjs": "4.0.2",
        "eslint-plugin-unicorn": "63.0.0",
        "git-cliff": "2.12.0",
        "globals": "17.4.0",
        "happy-dom": "20.9.0",
        "husky": "9.1.7",
        "jsonc-eslint-parser": "3.1.0",
        "license-checker": "25.0.1",
        "prettier": "3.8.1",
        "prettier-plugin-jsdoc": "1.8.0",
        "prettier-plugin-packagejson": "3.0.2",
        "prettier-plugin-sh": "0.18.0",
        "repomix": "1.12.0",
        "ts-node": "10.9.2",
        "tsc-alias": "1.8.16",
        "tsconfig-paths": "4.2.0",
        "typedoc": "0.28.17",
        "typescript": "6.0.2",
        "typescript-eslint": "8.58.2",
        "vite": "8.0.8",
        "vite-plugin-checker": "0.12.0",
        "vite-plugin-dts": "4.5.4",
        "vite-plugin-static-copy": "4.0.1",
        "vitest": "4.1.0"
    },
    "peerDependencies": {
        "mitt": "3.0.1",
        "standardized-audio-context": "25.3.77",
        "tweakpane": "4.0.5",
        "worker-timers": "8.0.30"
    },
    "engines": {
        "node": "22.14.0"
    }
}
