{
    "name": "scenegrid-workspace",
    "private": true,
    "description": "Snapshot-Driven Virtual Mixing Console Workspace",
    "license": "SEE LICENSE IN LICENSE.md",
    "author": {
        "name": "Igor Zabrodin",
        "url": "https://github.com/rapt0p7"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/rapt0p7/scenegrid-console"
    },
    "workspaces": [
        "packages/*",
        "examples"
    ],
    "type": "module",
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "dev": "npm run dev --workspace=examples",
        "changelog": "git cliff -o CHANGELOG.md",
        "changelog:latest": "git cliff --latest -o CHANGELOG.md",
        "changelog:preview": "git cliff --latest",
        "createDependencyGraph": "npx depcruise packages/engine/src packages/shared/src --config .dependency-cruiser.cjs --include-only \"^packages/(engine|shared)/src\" --exclude \"(__tests__|\\\\.test\\\\.ts$|\\\\.spec\\\\.ts$)\" --output-type mermaid > docs/dependency-graph.mmd",
        "license-checker": "license-checker --production --failOn \"GPL;GPL-1.0;GPL-2.0;GPL-3.0;LGPL;LGPL-2.0;LGPL-2.1;LGPL-3.0;AGPL;AGPL-1.0;AGPL-3.0;SSPL;CDDL;EUPL;MPL-1.0;NPL;QPL;CPAL;RPL\"",
        "lint:architecture": "depcruise packages/engine/src --config .dependency-cruiser.cjs",
        "prepare": "husky || true",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc -b",
        "format": "oxfmt --no-error-on-unmatched-pattern",
        "format:check": "oxfmt --check",
        "lint:fast": "oxlint --deny-warnings",
        "lint:arch": "eslint .",
        "lint": "npm run lint:fast && npm run lint:arch",
        "notebooklm:update": "npx repomix"
    },
    "devDependencies": {
        "@commitlint/cli": "20.5.0",
        "@commitlint/config-conventional": "20.5.0",
        "@eslint/js": "9.39.4",
        "@eslint/json": "1.1.0",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@vitest/coverage-v8": "4.1.8",
        "@vitest/eslint-plugin": "1.6.19",
        "browserslist": "4.28.1",
        "cross-env": "10.1.0",
        "dependency-cruiser": "17.4.3",
        "dotenv": "17.3.1",
        "eslint": "9.39.4",
        "eslint-import-resolver-typescript": "4.4.4",
        "eslint-plugin-boundaries": "6.0.2",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-markdownlint": "^0.8.1",
        "eslint-plugin-oxlint": "1.69.0",
        "git-cliff": "2.12.0",
        "globals": "17.4.0",
        "happy-dom": "20.10.1",
        "husky": "9.1.7",
        "jsonc-eslint-parser": "3.1.0",
        "license-checker": "25.0.1",
        "oxfmt": "0.54.0",
        "oxlint": "1.69.0",
        "oxlint-tsgolint": "0.23.0",
        "repomix": "1.14.1",
        "standardized-audio-context-mock": "10.0.0",
        "ts-node": "10.9.2",
        "tsc-alias": "1.8.16",
        "tsconfig-paths": "4.2.0",
        "typedoc": "0.28.17",
        "typescript": "6.0.2",
        "typescript-eslint": "8.60.1",
        "vite": "8.0.16",
        "vite-plugin-checker": "0.14.1",
        "vite-plugin-dts": "5.0.2",
        "vite-plugin-static-copy": "4.1.0",
        "vitest": "4.1.8"
    },
    "overrides": {
        "typedoc": {
            "typescript": "6.0.2"
        }
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "oxlint --fix",
            "oxfmt --no-error-on-unmatched-pattern",
            "eslint --cache"
        ],
        "*.{js,jsx}": [
            "oxfmt --no-error-on-unmatched-pattern"
        ],
        "*.json": "oxfmt --no-error-on-unmatched-pattern"
    },
    "browserslist": {
        "production": [
            "> 0.5%",
            "last 2 versions",
            "not IE <= 11",
            "not dead"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "engines": {
        "node": "22.14.0"
    }
}
