{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "jsx": "react",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "declaration": true,
        "sourceMap": true,
        "composite": true,
        "lib": ["ESNext", "DOM", "WebWorker"],
        "paths": {
            "@scene-grid/shared": ["./packages/shared/src/index.ts"],
            "@scene-grid/engine": ["./packages/engine/src/index.ts"],
            "@scene-grid/inspector": ["./packages/inspector/src/index.tsx"],
            "@scene-grid/debugger": ["./packages/debugger/src/index.ts"],
            "@scene-grid/cli": ["./packages/cli/src/index.ts"],
            "@scene-grid/mcp-server": ["./packages/mcp-server/index.ts"]
        }
    },
    "exclude": ["node_modules", "dist", "public"]
}
