{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "jsx": "react",
        "moduleResolution": "bundler",
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "declaration": true,
        "sourceMap": true,
        "outDir": "./public",
        "paths": {
            "@webaudio-core/*": ["./src/webaudio-core/*"],
            "@webaudio-core": ["./src/webaudio-core/index.ts"],
            "*": ["./*"]
        },
        "lib": ["ESNext", "DOM", "WebWorker"],
        "types": ["./src/audio-worklet-global-scope"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "examples/**/*.ts",
        "examples/**/*.tsx",
        "src/audio.d.ts",
        "*.ts",
        "*.config.js"
    ],
    "exclude": ["node_modules", "dist", "public"]
}
